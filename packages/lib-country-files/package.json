{
  "name": "@ham2k/lib-country-files",
  "version": "1.0.202605301",
  "description": "Country files data for amateur radio",
  "author": "Sebastian Delmont <sd@ham2k.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/ham2k/ham-js-libs.git"
  },
  "homepage": "https://github.com/ham2k/ham-js-libs/tree/main/packages/lib-country-files",
  "license": "MIT",
  "keywords": [
    "amateur radio",
    "ham radio",
    "country files",
    "entities",
    "dxcc"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "devDependencies": {
    "@jest/core": "^30.2.0",
    "@jest/test-sequencer": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "jest": "^30.2.0",
    "standard": "^17",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsup",
    "generate": "tsx ./scripts/generate.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "standard": {
    "env": [
      "jest"
    ]
  },
  "dependencies": {
    "@ham2k/lib-cqmag-data": "^1.0.0",
    "@ham2k/lib-callsigns": "^1.0.2"
  }
}