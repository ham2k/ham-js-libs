{
  "name": "@ham2k/lib-operation-data",
  "version": "1.0.2",
  "description": "Amateur radio basic operation data and definitions",
  "author": "Sebastian Delmont <sd@ham2k.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/ham2k/ham-js-libs.git"
  },
  "homepage": "https://github.com/ham2k/ham-js-libs/tree/main/packages/lib-operation-data",
  "license": "MIT",
  "keywords": [
    "amateur radio",
    "ham radio",
    "operation",
    "qso"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "jest": "~30",
    "standard": "^17.1.2",
    "ts-jest": "^29.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "standard": {
    "env": [
      "jest"
    ]
  }
}
