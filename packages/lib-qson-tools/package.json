{
  "name": "@ham2k/lib-qson-tools",
  "version": "1.4.1",
  "description": "Tools for working with QSON amateur radio QSO data",
  "author": "Sebastian Delmont <sd@ham2k.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/ham2k/ham-js-libs.git"
  },
  "homepage": "https://github.com/ham2k/ham-js-libs/tree/main/packages/lib-qson-tools",
  "license": "MIT",
  "keywords": [
    "amateur radio",
    "ham radio",
    "qso",
    "qson"
  ],
  "type": "module",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.0",
    "jest": "^30.2.0",
    "standard": "^17.0.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.3.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "standard": {
    "env": [
      "jest"
    ]
  }
}
